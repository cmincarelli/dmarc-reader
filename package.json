{
  "name": "dmarc-reader",
  "version": "0.1.0",
  "description": "Desktop application for analyzing DMARC reports with actionable insights",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "author": "Chris M",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run build:renderer && npm run build:electron && electron-builder",
    "build:mac": "npm run build -- --mac",
    "build:universal": "npm run build -- --mac --universal",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "download-geodata": "ts-node scripts/download-geodata.ts",
    "postinstall": "electron-builder install-app-deps",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json"
  },
  "dependencies": {
    "@maxmind/geoip2-node": "^4.0.1",
    "@tanstack/react-query": "^5.17.9",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^9.2.2",
    "chokidar": "^5.0.0",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "date-fns": "^3.0.6",
    "drizzle-orm": "^0.29.2",
    "electron-updater": "^6.1.7",
    "fast-xml-parser": "^4.3.3",
    "immer": "^10.0.3",
    "ipaddr.js": "^2.1.0",
    "lucide-react": "^0.562.0",
    "lz-string": "^1.5.0",
    "mapbox-gl": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-map-gl": "^7.1.7",
    "recharts": "^2.10.3",
    "tar": "^7.5.3",
    "uuid": "^9.0.1",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@electron/notarize": "^2.2.1",
    "@playwright/test": "^1.40.1",
    "@tailwindcss/forms": "^0.5.7",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.8",
    "@types/chokidar": "^2.1.7",
    "@types/d3-array": "^3.2.1",
    "@types/d3-scale": "^4.0.8",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.47",
    "@types/react-dom": "^18.2.18",
    "@types/tar": "^6.1.13",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.1.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.20.9",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "electron-icon-builder": "^2.0.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "fast-check": "^3.15.0",
    "jsdom": "^23.0.1",
    "playwright": "^1.40.1",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.1.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.dmarcreader.app",
    "productName": "DMARC Reader",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist-electron",
      "dist/index.html",
      "dist/assets/**/*",
      "build/icons/**/*",
      "assets/geo-data",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icons/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icons/",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
